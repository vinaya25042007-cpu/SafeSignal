{
  "version": 1,
  "author": "SafeSignal Team",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-led",
      "id": "led_green",
      "top": -120,
      "left": 180,
      "attrs": { "color": "green", "label": "SAFE (GPIO 25)" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_green",
      "top": -90,
      "left": 130,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led_yellow",
      "top": -30,
      "left": 180,
      "attrs": { "color": "yellow", "label": "NEED HELP (GPIO 26)" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_yellow",
      "top": 0,
      "left": 130,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led_red",
      "top": 60,
      "left": 180,
      "attrs": { "color": "red", "label": "MEDICAL (GPIO 27)" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_red",
      "top": 90,
      "left": 130,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": 160,
      "left": 180,
      "attrs": { "hasLocalSound": "1", "label": "BUZZER (GPIO 33)" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:25", "r_green:1", "green", [ "h0" ] ],
    [ "r_green:2", "led_green:A", "green", [ "h0" ] ],
    [ "led_green:C", "esp:GND.1", "black", [ "h0" ] ],
    [ "esp:26", "r_yellow:1", "gold", [ "h0" ] ],
    [ "r_yellow:2", "led_yellow:A", "gold", [ "h0" ] ],
    [ "led_yellow:C", "esp:GND.1", "black", [ "h0" ] ],
    [ "esp:27", "r_red:1", "red", [ "h0" ] ],
    [ "r_red:2", "led_red:A", "red", [ "h0" ] ],
    [ "led_red:C", "esp:GND.1", "black", [ "h0" ] ],
    [ "esp:33", "buzzer:2", "orange", [ "h0" ] ],
    [ "esp:GND.2", "buzzer:1", "black", [ "h0" ] ]
  ]
}
